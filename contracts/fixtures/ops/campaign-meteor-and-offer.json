          "wave": 1, "credits": 74,
          "placements": [{ "padId": "p04", "classId": "nova", "level": 1, "targeting": "FRONT" }],
          "colony": { "health": 18, "shield": 0 },
          "powers": {}
        }
      },
      "expect": {
        "result": "APPLIED",
        "state": {
          "revision": 3,
          "phase": "ACTIVITY",
          "wave": 2,
          "highestCompletedWave": 1,
          "snapshot": {
            "credits": 74,
            "placements": [{ "padId": "p04", "classId": "nova", "level": 1, "targeting": "FRONT" }],
            "colony": { "health": 18, "shield": 0 },
            "powers": {}
          }
        }
      }
    },
    {
      "note": "The normal activity resolves first; M-001 is still open, so the next phase is METEOR.",
