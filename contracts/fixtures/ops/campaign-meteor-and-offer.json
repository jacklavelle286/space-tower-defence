      "op": {
        "opId": "00000000-0000-4000-8000-000000000807", "expectedRevision": 6, "type": "START_WAVE", "clientTime": "2026-11-15T17:02:00Z",
        "payload": {
          "wave": 2, "credits": 54,
          "placements": [
            { "padId": "p04", "classId": "nova", "level": 1, "targeting": "FRONT" },
            { "padId": "p05", "classId": "nova", "level": 1, "targeting": "FRONT" }
          ]
        }
      },
      "expect": {
        "result": "APPLIED",
        "state": {
          "revision": 7,
          "phase": "IN_WAVE",
          "snapshot": {
            "credits": 54,
            "placements": [
              { "padId": "p04", "classId": "nova", "level": 1, "targeting": "FRONT" },
              { "padId": "p05", "classId": "nova", "level": 1, "targeting": "FRONT" }
