              "slotId": "M-001", "kind": "METEOR", "status": "SUCCEEDED",
              "attempts": [
                { "n": 1, "attemptId": "00000000-0000-4000-8000-000000000805", "answer": "8", "correct": false },
                { "n": 2, "attemptId": "00000000-0000-4000-8000-000000000806", "answer": "7", "correct": true }
              ],
              "accepted": ["7"], "withdrawn": false, "reward": { "credits": 0, "powerId": "frost-pulse" }
            }
          ]
        }
