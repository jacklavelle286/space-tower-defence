        "opId": "00000000-0000-4000-8000-000000000802", "expectedRevision": 3, "type": "SUBMIT_ATTEMPT", "clientTime": "2026-11-15T17:01:00Z",
        "payload": { "slotId": "N-001", "answer": "c" }
      },
      "expect": {
        "result": "APPLIED",
        "outcome": "RESOLVED_SUCCEEDED",
