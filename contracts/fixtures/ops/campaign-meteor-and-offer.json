{
  "name": "campaign-meteor-and-offer",
  "description": "A two-wave CAMPAIGN wave set with a meteor after wave 1 (synthetic: the real campaign has 50 waves, but the rules are the same for any length). After wave 1 the normal activity comes first, then the optional meteor; a correct meteor answer adds one power charge and never credits. Clearing the final wave of a CAMPAIGN set sets campaignCompleted and goes to COMPLETION_OFFER with wave staying at finalWave; from then on ABANDON is refused (FINISH_RUN and CHOOSE_ENDLESS are later ops).",
  "sources": [
    "F 3.4 (next-phase rule: ACTIVITY, then METEOR, then BUILD)",
    "spine S3.2 (COMPLETE_WAVE final CAMPAIGN wave -> campaignCompletedAt, COMPLETION_OFFER; ABANDON needs campaignCompletedAt unset)",
    "C 9.1 (meteor reward: one power charge, never credits), C 10"
  ],
  "start": {
    "mode": "CAMPAIGN",
    "status": "IN_PROGRESS",
    "stage": "AUTHORED",
    "phase": "IN_WAVE",
    "wave": 1,
    "finalWave": 2,
    "highestCompletedWave": 0,
    "campaignCompleted": false,
    "plannedThrough": 1,
    "revision": 2,
    "powerChargeCap": 2,
    "snapshot": {
      "credits": 50,
      "placements": [{ "padId": "p04", "classId": "nova", "level": 1, "targeting": "FRONT" }],
      "colony": { "health": 20, "shield": 0 },
      "powers": {}
    },
    "slots": [
      { "slotId": "N-001", "kind": "NORMAL", "status": "UNRESOLVED", "attempts": [], "accepted": ["c"], "withdrawn": false, "reward": { "credits": 30 } },
      { "slotId": "M-001", "kind": "METEOR", "status": "UNRESOLVED", "attempts": [], "accepted": ["7"], "withdrawn": false, "reward": { "credits": 0, "powerId": "frost-pulse" } }
    ]
  },
  "steps": [
