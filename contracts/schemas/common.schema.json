{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Common",
  "description": "Shared definitions for the run contracts (spine S4, S9.5; G section 5.2). Numeric bounds and patterns equal contracts/limits.json (checked by a Vitest test).",
  "$defs": {
    "uuid": {
      "description": "opId, runId, sessionId: lower-case UUID (crypto.randomUUID form).",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "slotId": {
      "description": "N-<i> normal activity after wave i, M-<i> meteor after wave i (spine S3.3).",
      "type": "string",
      "pattern": "^[NM]-[0-9]{3}$"
    },
    "keyId": {
      "description": "Every other key ID: hyphenated lower case (pads p01..p16, classes nova, powers frost-pulse).",
      "type": "string",
      "pattern": "^[a-z0-9-]{1,40}$"
    },
    "count": {
      "description": "A non-negative integer kept inside 32 bits so JavaScript and Python agree.",
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "wave": {
      "description": "1-based wave number; 999 ends an endless run (limits endless.finalWave).",
      "type": "integer",
      "minimum": 1,
      "maximum": 999
    },
    "targeting": {
      "type": "string",
      "enum": ["FRONT", "FAST", "CROWD", "STRONG"]
    },
    "placement": {
      "type": "object",
      "properties": {
        "padId": { "$ref": "#/$defs/keyId" },
        "classId": { "$ref": "#/$defs/keyId" },
        "level": { "type": "integer", "minimum": 1, "maximum": 3 },
        "targeting": { "$ref": "#/$defs/targeting" }
      },
      "required": ["padId", "classId", "level", "targeting"],
      "additionalProperties": false
    },
    "placements": {
      "description": "At most 32 entries; the pad count in the bounds file is the real cap (Phase 30).",
      "type": "array",
      "items": { "$ref": "#/$defs/placement" },
      "maxItems": 32
    },
    "colony": {
      "type": "object",
      "properties": {
        "health": { "$ref": "#/$defs/count" },
        "shield": { "$ref": "#/$defs/count" }
      },
      "required": ["health", "shield"],
      "additionalProperties": false
    },
    "powers": {
      "description": "powerId -> charges held.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/keyId" },
      "additionalProperties": { "$ref": "#/$defs/count" }
    },
    "snapshot": {
      "description": "The one run snapshot (spine S4).",
      "type": "object",
      "properties": {
        "credits": { "$ref": "#/$defs/count" },
        "placements": { "$ref": "#/$defs/placements" },
        "colony": { "$ref": "#/$defs/colony" },
        "powers": { "$ref": "#/$defs/powers" }
      },
      "required": ["credits", "placements", "colony", "powers"],
      "additionalProperties": false
    },
    "answer": {
      "description": "One canonical answer string, at most 64 characters, for every interaction type (spine S3.3, C20.1). Python checks only this shape.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9' ;=,|-]{1,64}$"
    },
    "clientTime": {
      "description": "Informational client UTC time; never trusted.",
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    }
  }
}
