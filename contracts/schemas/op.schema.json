{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "op.schema.json",
  "title": "Op",
  "description": "One run op (spine S3.2, S7.1, G sections 5.1 and 6) for protocolVersion 1: the eight queueable ops, plus CHOOSE_ENDLESS, which the reducers apply but which travels only in the R12 endless body (the /ops envelope refuses it; CREATE_RUN has its own route). The payload is checked by the branch for its type.",
  "type": "object",
  "properties": {
    "opId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "expectedRevision": {
      "$ref": "common.schema.json#/$defs/count"
    },
    "type": {
      "type": "string",
      "enum": [
        "SAVE_PREP",
        "START_WAVE",
        "COMPLETE_WAVE",
        "SUBMIT_ATTEMPT",
        "DISMISS_SLOT",
        "DEFEAT",
        "ABANDON",
        "FINISH_RUN",
        "CHOOSE_ENDLESS"
      ]
    },
    "payload": {
      "type": "object"
    },
    "clientTime": {
      "$ref": "common.schema.json#/$defs/clientTime"
    }
  },
  "required": [
    "opId",
    "expectedRevision",
    "type",
    "payload",
    "clientTime"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "SAVE_PREP"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "op-save-prep.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "START_WAVE"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "op-start-wave.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "COMPLETE_WAVE"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "op-complete-wave.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "SUBMIT_ATTEMPT"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "op-submit-attempt.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "DEFEAT"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "op-defeat.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ABANDON"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "op-abandon.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "DISMISS_SLOT"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "op-dismiss-slot.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "FINISH_RUN"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "op-finish-run.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "CHOOSE_ENDLESS"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "op-choose-endless.schema.json"
          }
        }
      }
    }
  ]
}
