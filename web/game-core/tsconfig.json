{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // No "DOM" in lib and no Node types: window, document, setTimeout, performance, process and
    // friends do not type-check in the rules code. Tests are checked by tsconfig.test.json.
    "lib": ["ES2023"],
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
