{
  "name": "@scd/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Code shared by the player and admin apps: API types, limits, answer canonicaliser, learning panel, audio, API client, map art and layout. No Phaser.",
  "exports": {
    ".": "./src/index.ts",
    "./audio": "./src/audio/index.ts",
    "./learning": "./src/learning/index.ts",
    "./learning/reading.css": "./src/learning/reading.css",
    "./learning/testing": "./src/learning/keyboardTesting.ts",
    "./audio/testing": "./src/audio/testing.ts",
    "./map": "./src/map/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/andika": "5.3.0",
    "@scd/game-core": "0.0.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3"
  }
}
