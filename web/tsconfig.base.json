{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    // game-core/src/data/game-data.ts and src/map/ import with .ts extensions so Node 24 runs
    // game-core/scripts/build-bounds.ts directly (type stripping has no resolver); allowed because nothing emits.
    "allowImportingTsExtensions": true
  }
}
